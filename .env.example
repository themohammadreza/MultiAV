# Required Docker Compose environment variables (fill these before `docker compose up`).
POSTGRES_USER=multiav_user
POSTGRES_PASSWORD=multiav_password
POSTGRES_DB=multiav_db

DATABASE_URL=postgresql://multiav_user:multiav_password@postgres:5432/multiav_db
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

STORAGE_S3_ENDPOINT=http://minio:9000
STORAGE_S3_BUCKET=multiav
STORAGE_S3_REGION=us-east-1
STORAGE_S3_ACCESS_KEY=minio_username
STORAGE_S3_SECRET_KEY=minio_password

ADMIN_DEFAULT_USERNAME=admin
ADMIN_DEFAULT_PASSWORD=admin_password
